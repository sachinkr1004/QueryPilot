  "regression_policy": {
    "semantic_accuracy": {
      "allowed_drop_percentage_points": 0,
      "rule": "Must not decrease from the frozen Phase-9 production baseline."
    },

    "execution_success_rate": {
      "allowed_drop_percentage_points": 0,
      "rule": "Must not decrease from the frozen Phase-9 production baseline."
    },

    "strict_accuracy": {
      "allowed_drop_percentage_points": 2.5,
      "maximum_additional_failures": 1,
      "rule": "At most one additional strict failure on the 40-question benchmark, and only when semantic accuracy does not regress."
    }
  },

  "safety_policy": {
    "allowed_safety_regressions": 0,
    "rule": "No optimization may weaken SQL safety guarantees."
  },

  "reliability_policy": {
    "rule": "Infrastructure or provider failures must be separated from QueryPilot correctness failures before accepting or rejecting an optimization."
  },

  "experiment_policy": {
    "change_one_major_variable_at_a_time": true,
    "investigate_suspicious_regressions": true,
    "do_not_tune_on_phase8_final_test": true,
    "preserve_phase8_official_result": true,
    "baseline_must_be_measured_before_optimization": true
  }
